-- Cooldown at Action Logic
local deb = false
local cooldownDuration = 60
local isAutoLooping = false

local function showCooldownBadge()
    badgeLabel.Visible = true
    task.wait(1.5)
    badgeLabel.Visible = false
end

local function executeDupeAction()
    if deb then
        task.spawn(showCooldownBadge)
        return false
    end
    
    local slotNum = tonumber(slotTextBox.Text)
    if not slotNum then
        slotTextBox.Text = ""
        slotTextBox.PlaceholderText = "Ilagay ang slot number!"
        if isAutoLooping then
            isAutoLooping = false
            autoLoopButton.Text = "Auto Dupe Loop: OFF"
            autoLoopButton.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
        end
        return false
    end
    
    deb = true 
    
    local char = player.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        
        if root then
            root.CFrame = CFrame.new(root.Position.X, -350, root.Position.Z)
        end
        
        -- Wait until player dies naturally in the void before sending reload
        if humanoid then
            local died = false
            local connection
            connection = humanoid.Died:Connect(function()
                died = true
                if connection then connection:Disconnect() end
            end)
            
            local startTime = tick()
            while not died and humanoid.Health > 0 and (tick() - startTime < 15) do
                task.wait(0.1)
            end
            if connection then connection:Disconnect() end
        else
            task.wait(3.5)
        end
    end
    
    local loadSaveRequests = game:GetService("ReplicatedStorage"):FindFirstChild("LoadSaveRequests")
    if loadSaveRequests and loadSaveRequests:FindFirstChild("RequestLoad") then
        pcall(function()
            loadSaveRequests.RequestLoad:InvokeServer(slotNum)
        end)
    end
    
    -- Cooldown timer displayed directly on the action button
    local originalText = actionButton.Text
    actionButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    
    for i = cooldownDuration, 0, -1 do
        actionButton.Text = "Wait: " .. i .. "s"
        task.wait(1)
    end
    
    actionButton.Text = originalText
    actionButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    deb = false 
    return true
end

-- Background auto loop routine
task.spawn(function()
    while true do
        if isAutoLooping and not deb then
            pcall(executeDupeAction)
        else
            task.wait(0.5)
        end
    end
end)

local function getPlayerBasePosition()
    local properties = game:GetService("Workspace"):FindFirstChild("Properties")
    if properties then
        for _, property in pairs(properties:GetChildren()) do
            local owner = property:FindFirstChild("Owner")
            if owner and owner.Value == player then
                local origin = property:FindFirstChild("OriginPart") or property:FindFirstChildWhichIsA("BasePart")
                if origin then
                    return origin.CFrame + Vector3.new(0, 5, 0)
                end
            end
        end
    end
    return nil
end

tpBaseButton.MouseButton1Click:Connect(function()
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local baseCFrame = getPlayerBasePosition()
        if baseCFrame then
            char.HumanoidRootPart.CFrame = baseCFrame
        else
            slotTextBox.Text = ""
            slotTextBox.PlaceholderText = "Base hindi pa handa/loaded!"
        end
    end
end)

actionButton.MouseButton1Click:Connect(function()
    pcall(executeDupeAction)
end)

